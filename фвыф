.github/workflows/build.yml
name: Build Mod
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v3
        with:
          java-version: '17'
      - run: ./gradlew build
      - uses: actions/upload-artifact@v3
        with:
          name: mod
          path: build/libs/*.jar
